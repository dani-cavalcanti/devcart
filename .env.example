# Copie para .env e ajuste (o .env NAO e versionado).
# Usado pelo docker-compose.full.yml e pelos serviços em execução local.

# Segredo HMAC do JWT validado pelo api-gateway (HS256, >= 32 bytes).
# Gere um valor proprio, ex.:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME_use_um_valor_aleatorio_de_no_minimo_32_bytes
JWT_ISSUER=

# Credenciais locais (dev). Em produção, injete via secret manager.
POSTGRES_PASSWORD=pedidos
RABBITMQ_PASSWORD=guest
